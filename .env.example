# --- LLM (optional). Without a key SYNAPSE runs in heuristic mode: pattern-matched, always-cited extraction.
ANTHROPIC_API_KEY=
SYNAPSE_LLM_MODEL=claude-sonnet-5-5

# --- Retrieval
SYNAPSE_USE_NEURAL=1          # 1 = sentence-transformers + cross-encoder when installed; 0 = offline fallbacks
SYNAPSE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SYNAPSE_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
SYNAPSE_MAX_PAPERS=15

# --- Observability (optional)
SYNAPSE_LANGFUSE=0
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
